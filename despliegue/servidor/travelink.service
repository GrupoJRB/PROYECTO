[Unit]
Description=TRAVELINK Spring Boot Application Service
After=syslog.target network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=travelink
Group=travelink
WorkingDirectory=/opt/travelink
Environment="SPRING_PROFILES_ACTIVE=prod"
Environment="JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64"
EnvironmentFile=/etc/travelink/travelink.env
ExecStart=/usr/bin/java -Xms512m -Xmx1024m -XX:+UseG1GC -jar /opt/travelink/travelink.jar
SuccessExitStatus=143
TimeoutStopSec=30
Restart=on-failure
RestartSec=10

# Hardening de Seguridad del Servicio
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
